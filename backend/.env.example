PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://skill_tree_app:replace_locally@127.0.0.1:5432/skill_tree_dev
# Production: use a least-privilege runtime role for DATABASE_URL and a separate owner credential only for migrations/admin provisioning.
DATABASE_MIGRATION_URL=
DB_POOL_MAX=10
DATABASE_SSL=false
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_REQUESTS=300
AUTH_RATE_LIMIT_REQUESTS=20
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=15
ADMIN_SESSION_TTL_HOURS=8
PUBLIC_APP_URL=http://localhost:5174
EMAIL_CODE_SECRET=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_COOLDOWN_MINUTES=5
# Leave SMTP_* empty for development; welcome/reset-code email payloads are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
